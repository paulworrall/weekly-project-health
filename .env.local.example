# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Set the same variables in Vercel for Production, Preview and Development (redeploy after a change).
# This project has its OWN Neon project, Vercel project and secrets: never reuse the
# Reporting Hub's or Project Brain's.

# Neon Postgres (EU region). The app uses the POOLED connection string (host contains "-pooler"):
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# Migrations use the DIRECT (unpooled) connection string:
#   DATABASE_URL="$DIRECT_URL" npx prisma migrate deploy
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# NextAuth secret, new for this project. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-generated-secret"

# App base URL
NEXTAUTH_URL="http://localhost:3000"

# Shared secret Vercel Cron sends to the weekly close job (brief 06). Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-generated-secret"

# No Anthropic key: there is no AI in v1.
