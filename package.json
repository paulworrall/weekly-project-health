    "user:create-admin": "tsx scripts/create-admin.mts",
    "upload:dry-run": "tsx scripts/dry-run-upload.mts",
    "week:close": "tsx scripts/close-week.mts",
    "snapshots:backfill": "tsx scripts/backfill-snapshots.mts",
    "pipeline:sample-values": "tsx scripts/pipeline-sample-values.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "exceljs": "4.4.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
